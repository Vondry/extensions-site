{% if record.screenshots %}
    {% if record.screenshots is iterable %}
        {% set screenshots = record.screenshots %}
    {% else %}
        {% set screenshots = [record.screenshots] %}
    {% endif %}

    {% set screenshot = screenshots|first.value|first %}
    {% if screenshot
        and record.repository matches '#^https://github\\.com/[^/]+/[^/]+/?$#'
        and screenshot matches '#^[A-Za-z0-9._/-]+\\.(gif|jpe?g|png|webp)$#i'
        and '..' not in screenshot
        and not (screenshot starts with '/')
    %}
            <figure class="image">
                {% set imageUrl = record.repository|trim('/')|replace({'https://github.com': 'https://raw.githubusercontent.com'}) ~ '/master/' ~ screenshot %}
                <a href="{{ imageUrl }}">
                    <img src="{{ imageUrl }}" alt="Screenshot of {{ record|title }}"
                         style="width: 300px; border:1px solid #CCC; margin-right: 1rem;">
                </a>
            </figure>

    {% endif %}
{% endif %}
